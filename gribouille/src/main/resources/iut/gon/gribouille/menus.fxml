<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.ToggleGroup?>

<MenuBar xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iut.gon.gribouille.controleurs.MenusController">
	<Menu text="Fichier">
		<MenuItem text="Charger" onAction="#onCharge"/>
		<MenuItem text="Sauvergarder" onAction="#onSauvegarde"/>
		<MenuItem text="Exporter" onAction="#onExporte"/>
		<SeparatorMenuItem/>
		<MenuItem text="Quitter" onAction="#onQuitte"/>
	</Menu>
	<Menu text="Edition">
		<MenuItem text="Retour arrière" disable="true"/>
		<MenuItem text="Retour avant" disable="true"/>
		<SeparatorMenuItem/>
		<MenuItem text="Effacer tout" onAction="#onEffacerTout"/>
	</Menu>
	<Menu text="Outils">
		<Menu text="Epaisseur">
			<RadioMenuItem text="1">
				<toggleGroup>
					<ToggleGroup fx:id="epaisseurGroup"/>
				</toggleGroup>
			</RadioMenuItem>
			<RadioMenuItem text="2" toggleGroup="$epaisseurGroup"/>
		 	<RadioMenuItem text="3" toggleGroup="$epaisseurGroup"/>
			<RadioMenuItem text="4" toggleGroup="$epaisseurGroup"/>
			<RadioMenuItem text="5" toggleGroup="$epaisseurGroup"/>
			<RadioMenuItem text="6" toggleGroup="$epaisseurGroup"/>
			<RadioMenuItem text="7" toggleGroup="$epaisseurGroup"/>
			<RadioMenuItem text="8" toggleGroup="$epaisseurGroup"/>
			<RadioMenuItem text="9" toggleGroup="$epaisseurGroup"/>
		</Menu>
		<SeparatorMenuItem/>
		<RadioMenuItem text="Crayon" selected="true" fx:id="crayon">
			<toggleGroup>
				<ToggleGroup fx:id="outilGroup"/>
			</toggleGroup>
		</RadioMenuItem>
		<RadioMenuItem text="Etoile" toggleGroup="$outilGroup" fx:id="etoile"/>
		<RadioMenuItem text="Gomme" toggleGroup="$outilGroup" fx:id="gomme" disable="true"/>
 	</Menu>
 	<Menu text="Aide">
 		<MenuItem text="Mappage" disable="true"/>
 		<MenuItem text="A propos" onAction="#onAPropos"/>
 	</Menu>
</MenuBar>
